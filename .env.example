# بيانات تيليقرام الأساسية (مطلوبة)
# احصل على API_ID و API_HASH من: https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# احصل على BOT_TOKEN من @BotFather في تيليقرام
BOT_TOKEN=1234567890:your_bot_token_here

# ==========================================
# إعدادات اختيارية للأداء والجودة
# ==========================================

# عدد التحميلات المتزامنة في نفس الوقت (الافتراضي: 3)
MAX_CONCURRENT_DOWNLOADS=3

# عدد الأجزاء المتوازية لتسريع تحميل المقطع الواحد (الافتراضي: 8)
CONCURRENT_FRAGMENTS=8

# أقصى حجم للملف بالميجابايت (الحد الأقصى في تيليقرام 2000MB - الافتراضي: 1990)
MAX_FILE_SIZE_MB=1990

# أقصى دقة فيديو بالبكسل (مثلاً 2160 لـ 4K أو 1080 لـ Full HD - اتركه فارغاً لأعلى جودة متاحة)
MAX_VIDEO_HEIGHT=

# تفضيل كودك H.264/AAC لضمان التشغيل السلس على جميع أجهزة iOS و Android (true/false)
# عند تفعيلها على يوتيوب سيحمل حتى 1080p60 بـ H.264 أو أعلى إذا كان متاحاً، وعند تعطيلها يختار 4K/VP9/AV1 أولاً
PREFER_COMPATIBLE_CODEC=false

# مسار ملف الكوكيز (اختياري - مفيد للمقاطع المقيدة بالعمر في يوتيوب أو منشورات إنستقرام)
COOKIES_FILE=cookies.txt

# تقييد البوت لمستخدمين محددين عبر ID (اختياري - افصل بينهم بفاصلة، اتركه فارغاً للجميع)
ALLOWED_USERS=
